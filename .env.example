# Database — SQLite for local development.
# For production, switch prisma/schema.prisma datasource to "postgresql"
# and point this at your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Session signing secret. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-32-byte-random-string"

# Standard working hours per day, used to derive extra hours.
STANDARD_WORK_HOURS="8"

# Public URL of this installation, used in links inside emails.
APP_URL="http://localhost:3000"
