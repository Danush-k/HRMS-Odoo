// Dayflow HRMS — data model
//
// SQLite is used for local development so the project runs with zero setup.
// To move to PostgreSQL, change `provider` to "postgresql", point DATABASE_URL
// at your instance and run `prisma db push`. No model changes are required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A tenant. Created during sign-up along with its first administrator.
model Company {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  logo               String?
  workingDaysPerWeek Int      @default(5)
  standardWorkHours  Float    @default(8)
  createdAt          DateTime @default(now())

  employees       Employee[]
  leaveTypes      LeaveType[]
  auditLogs       AuditLog[]
  publicHolidays  PublicHoliday[]
}

/// A person. Also the authentication principal — there is no separate user table,
/// which keeps the login identity and the HR record from drifting apart.
model Employee {
  id                 String  @id @default(cuid())
  companyId          String
  loginId            String  @unique
  email              String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)
  role               String  @default("EMPLOYEE") // ADMIN | HR | EMPLOYEE
  status             String  @default("ACTIVE") // ACTIVE | INACTIVE

  /// Sessions issued before this instant are refused. Bumping it signs every
  /// device out at once, which is what a password change has to do.
  sessionsValidFrom DateTime @default(now())

  /// Null until the address has been confirmed through an emailed link.
  emailVerifiedAt DateTime?

  firstName   String
  lastName    String
  jobPosition String?
  department  String?
  location    String?
  mobile      String?
  avatar      String?
  managerId   String?

  // Private information
  dateOfBirth     DateTime?
  residingAddress String?
  nationality     String?
  personalEmail   String?
  gender          String?
  maritalStatus   String?
  dateOfJoining   DateTime  @default(now())

  // Bank details
  accountNumber String?
  bankName      String?
  ifscCode      String?
  panNo         String?
  uanNo         String?
  empCode       String?

  // Resume
  about          String?
  loveAboutJob   String?
  interests      String?
  skills         String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager             Employee?           @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports             Employee[]          @relation("Reports")
  salary              Salary?
  salaryRevisions     SalaryRevision[]
  salaryRevisionsMade SalaryRevision[]    @relation("SalaryChangedBy")
  payslips            Payslip[]
  payslipsGenerated   Payslip[]           @relation("PayslipGeneratedBy")
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]      @relation("Requester")
  reviewedRequests    LeaveRequest[]      @relation("Reviewer")
  leaveBalances       LeaveBalance[]
  tokens              VerificationToken[]
  documents           Document[]
  auditLogs           AuditLog[]

  @@index([companyId])
}

/// Salary structure. Percentages are stored, amounts are always derived, so a
/// change to the monthly wage can never leave the components stale.
model Salary {
  id         String @id @default(cuid())
  employeeId String @unique

  monthlyWage              Float @default(0)
  workingDaysPerWeek       Int   @default(5)
  breakHours               Float @default(1)
  basicPercent             Float @default(50)
  hraPercentOfBasic        Float @default(50)
  standardAllowancePercent Float @default(16.67)
  performanceBonusPercent  Float @default(8.33)
  ltaPercent               Float @default(8.33)
  pfPercent                Float @default(12)
  professionalTax          Float @default(200)

  /// When this structure took effect. Moved forward on every edit, and copied
  /// into the outgoing SalaryRevision so history and current state share one
  /// unbroken timeline instead of two.
  effectiveFrom DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

/// A superseded salary structure. Written once, at the moment a structure stops
/// applying, so a wage change never erases what the basis used to be — the gap
/// this closes is that a payslip already issued, or a question about last
/// quarter's basis, must be answerable from data instead of memory.
model SalaryRevision {
  id         String @id @default(cuid())
  employeeId String

  monthlyWage              Float
  workingDaysPerWeek       Int
  breakHours               Float
  basicPercent             Float
  hraPercentOfBasic        Float
  standardAllowancePercent Float
  performanceBonusPercent  Float
  ltaPercent               Float
  pfPercent                Float
  professionalTax          Float

  effectiveFrom DateTime
  effectiveTo   DateTime

  changedById String
  createdAt   DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changedBy Employee @relation("SalaryChangedBy", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

/// One frozen record per employee per month. Every figure is copied at
/// generation time from Salary and from that month's attendance, and is never
/// recomputed afterward — a salary change or an attendance correction made
/// later must not silently rewrite a payslip already issued. Regenerating the
/// same period is allowed and overwrites it; there is no draft or lock state.
model Payslip {
  id         String @id @default(cuid())
  employeeId String

  periodYear  Int
  periodMonth Int // 1-12

  monthlyWage     Float
  basic           Float
  grossMonthly    Float
  pfEmployee      Float
  pfEmployer      Float
  professionalTax Float
  totalDeductions Float
  /// The full component breakdown (SalaryComponent[]) as JSON, so the payslip
  /// can show every line even though only the totals above are indexed.
  componentsJson  String

  totalWorkingDays Float
  payableDays      Float
  paidLeaveDays    Float
  /// Full month's net, prorated against payableDays / totalWorkingDays.
  netPay           Float

  generatedAt   DateTime @default(now())
  generatedById String

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy Employee @relation("PayslipGeneratedBy", fields: [generatedById], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model LeaveType {
  id                 String  @id @default(cuid())
  companyId          String
  name               String
  code               String // PAID | SICK | UNPAID
  isPaid             Boolean @default(true)
  defaultDays        Float   @default(0)
  requiresAttachment Boolean @default(false)
  colour             String  @default("#7A3E8F")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]
  balances LeaveBalance[]

  @@unique([companyId, code])
}

model LeaveBalance {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Float  @default(0)
  used        Float  @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Float
  remarks     String?
  attachment  String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED

  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())

  employee  Employee  @relation("Requester", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer  Employee? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

/// One row per employee per day. The unique constraint is what makes
/// check-in idempotent — a double click cannot create a second record.
model Attendance {
  id            String    @id @default(cuid())
  employeeId    String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  workedMinutes Int       @default(0)
  status        String    @default("ABSENT") // PRESENT | ABSENT | HALF_DAY | LEAVE
  note          String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

/// An employee document or certificate attachment.
model Document {
  id         String   @id @default(cuid())
  employeeId String
  name       String
  category   String   @default("OTHER") // CONTRACT | RESUME | IDENTIFICATION | MEDICAL | OTHER
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String   @default("EMPLOYEE") // EMPLOYEE | HR | ADMIN
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

/// Audit log for recording critical actions (attendance adjustments, salary edits, leave overrides).
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String
  action     String   // ATTENDANCE_UPDATE | SALARY_UPDATE | LEAVE_OVERRIDE | PROFILE_UPDATE
  targetType String   // Employee | Attendance | Salary | LeaveRequest
  targetId   String
  changes    String   // JSON payload of changes
  createdAt  DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([targetType, targetId])
}

/// L10 — a company-wide public holiday. Working days falling on one of these
/// dates are not charged to an employee's leave balance.
model PublicHoliday {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // e.g. "Independence Day", "Diwali", "New Year's Day"
  date        DateTime // Normalised UTC midnight date
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

/// A single-use, time-limited link. Only the SHA-256 of the token is stored, so
/// a copy of the database does not hand over working links.
model VerificationToken {
  id         String    @id @default(cuid())
  employeeId String
  tokenHash  String    @unique
  purpose    String    // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose])
  @@index([expiresAt])
}

/// One row per sign-in attempt, successful or not. Backs the rate limit and
/// gives HR a trail when an account is being probed.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ip         String?
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

